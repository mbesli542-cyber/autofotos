# ---------------------------------------------------------------------------
# AutoExperten Photo – environment variables
# Copy to .env.local and fill in. Without the Supabase values the app runs
# in DEMO MODE (local demo data in the browser, any login works).
# ---------------------------------------------------------------------------

# Supabase project (the project's API settings in the Supabase dashboard).
# Public values – safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
# Public client key – set ONE of the two (uncomment it):
#   PUBLISHABLE_KEY – the "publishable" key (sb_publishable_…), the default of
#                     new Supabase projects
#   ANON_KEY        – the legacy "anon" key (a JWT) of older projects
# Both are public; every request still runs with the employee's session and
# Row Level Security. If both are set, ANON_KEY wins. An empty value counts as
# not set – without a key the app runs in demo mode.
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The service role key (it bypasses RLS) does NOT belong in the app's
# environment – not here, not as a NEXT_PUBLIC_ variable, not in Vercel. Only
# the image processor reads it, in Supabase mode, from processor/.env
# (see the processor-side list at the end of this file).

# Data backend – chosen independently of the image processor.
#   (unset)  – Supabase if NEXT_PUBLIC_SUPABASE_URL + key are set, otherwise demo mode
#   demo     – demo mode (IndexedDB in the browser) even if Supabase is configured
#   supabase – Supabase; without the Supabase values the app falls back to demo
#              mode and logs a console warning
# Read by browser and server; NEXT_PUBLIC_ values are baked in at build time.
# NEXT_PUBLIC_DATA_BACKEND=demo

# ---------------------------------------------------------------------------
# Image processing (processor/, Python/FastAPI) – server-side
# ---------------------------------------------------------------------------
# There is NO simulated processing. "Bearbeitet" only ever shows real results
# of the processor (vehicle cut out + AutoExperten showroom, floor shadow,
# official branding). Without a connected processor the processing page shows
# "Echte Showroom-Bearbeitung ist noch nicht verbunden." and saves nothing.
#   mock (default) – no processor connected
#   real           – use the processor at IMAGE_PROCESSING_API_URL
# Works with both data backends: Supabase mode sends ids (POST {url}/jobs, the
# processor reads/writes Supabase storage); demo mode uploads a downscaled copy
# of each photo (POST {url}/jobs/upload) and stores the result in the browser.
# The processor never runs on Vercel (segmentation model, ≈ 7 GB RAM per job).
IMAGE_PROCESSOR=mock
# Base URL of the processor; may include a path prefix
# (e.g. https://intern.example.com/processor). Never exposed to the browser.
# IMAGE_PROCESSING_API_URL=http://localhost:8000
# Shared secret, sent as "Authorization: Bearer …". Server-side only, never
# NEXT_PUBLIC_. Must equal PROCESSOR_API_KEY of the processor (empty = no auth,
# only acceptable for a processor started locally with uvicorn – the
# processor's Docker image does not start without a key).
# IMAGE_PROCESSING_API_KEY=

# UI hint for the first render of the processing page only ("real" shows
# "Bildverarbeitung wird geprüft…" instead of "nicht verbunden" until
# GET /api/processing-status has answered). Not a switch.
NEXT_PUBLIC_IMAGE_PROCESSOR=mock

# Demo mode only: access code for the processing routes (/api/process-upload,
# /api/process-job/*). Employees enter it once per device on the processing
# page (header x-processing-access-code). RISK if unset on a public demo
# deployment with IMAGE_PROCESSOR=real: every visitor can upload photos to your
# processor (CPU/RAM heavy, ≈ 7 GB per job) – always set it there.
# Supabase mode uses the normal login instead.
# PROCESSING_ACCESS_CODE=

# Developer test page /dev/processing-test and its /api/dev/* proxy routes.
# Always available in `npm run dev`. In production builds they answer 404
# unless this is "true" (read at runtime). The dev routes are NOT behind the
# login – enable them only on internal/staging deployments.
ENABLE_DEV_TOOLS=false

# ---------------------------------------------------------------------------
# Processor-side variables – they belong in processor/.env (read by the Python
# service, template: processor/.env.example), NOT in the Next.js environment.
# Listed here for reference only.
# ---------------------------------------------------------------------------
# PROCESSOR_API_KEY=                          # must equal IMAGE_PROCESSING_API_KEY
# PROCESSOR_REQUIRE_API_KEY=false             # true: refuse to start without PROCESSOR_API_KEY (the Docker image sets true)
# PROCESSOR_DEBUG=false                       # true: keep debug files (mask, cut-out, …) per job
# PROCESSOR_SEGMENTATION_MODEL=birefnet-general-lite
# PROCESSOR_DETECTOR_MODEL=rf-detr-seg-medium # vehicle detector of the semantic mask check
# PROCESSOR_MODELS_DIR=./models               # ONNX models (segmentation + detector)
# PROCESSOR_DATA_DIR=./data                   # job uploads, results, debug files
# PROCESSOR_ASSETS_DIR=../public              # presets/ and brand/ (showroom plates, logo)
# PROCESSOR_CONCURRENCY=1                     # parallel jobs
# PROCESSOR_THREADS=0                         # ONNX Runtime threads (0 = automatic)
# PROCESSOR_JOB_TTL_HOURS=24                  # finished jobs are deleted afterwards
# PROCESSOR_MAX_UPLOAD_MB=40
# SUPABASE_URL=                               # Supabase mode: read originals / write results
# SUPABASE_SERVICE_ROLE_KEY=                  # Supabase mode, processor only – never in the app's environment
