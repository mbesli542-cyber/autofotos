# ---------------------------------------------------------------------------
# AutoExperten Photo – environment variables
# Copy to .env.local and fill in. Without the Supabase values the app runs
# in DEMO MODE (local mock data in the browser, any login works).
# ---------------------------------------------------------------------------

# Supabase project (Project Settings → API). Public values – safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
# "anon" key (legacy) or the new "publishable" key – one of both is enough.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER put the service role key into a NEXT_PUBLIC_ variable.
# It is not needed by the app. A future processing worker may use it server-side:
# SUPABASE_SERVICE_ROLE_KEY=

# Image processing backend (server-side).
#   mock (default) – simulated processing, no external service
#   real           – forwards jobs to IMAGE_PROCESSING_API_URL
IMAGE_PROCESSOR=mock
# IMAGE_PROCESSING_API_URL=https://processing.example.com
# IMAGE_PROCESSING_API_KEY=

# UI hint only: set to "real" together with IMAGE_PROCESSOR=real to hide the
# "Vorschau-Version" notice on the processing page.
NEXT_PUBLIC_IMAGE_PROCESSOR=mock

# ---------------------------------------------------------------------------
# Stage 2 – image processor (processor/, Python/FastAPI)
# ---------------------------------------------------------------------------
# Next.js side (this file / .env.local). Uncomment to use the real processor
# (later lines override the mock values above). The processor must be
# running (see processor/).
#
# IMAGE_PROCESSOR=real
# NEXT_PUBLIC_IMAGE_PROCESSOR=real
# Base URL of the processor; may include a path prefix
# (e.g. https://intern.example.com/processor).
# IMAGE_PROCESSING_API_URL=http://localhost:8000
# Shared secret, sent as "Authorization: Bearer …". Server-side only, never
# NEXT_PUBLIC_. Must equal PROCESSOR_API_KEY of the processor (empty = no auth,
# only acceptable locally).
# IMAGE_PROCESSING_API_KEY=

# Developer test page /dev/processing-test and its /api/dev/* proxy routes.
# Always available in `npm run dev`. In production builds they answer 404
# unless this is "true" (read at runtime). The dev routes are NOT behind the
# login – enable them only on internal/staging deployments.
ENABLE_DEV_TOOLS=false

# ---------------------------------------------------------------------------
# Processor-side variables – they belong in processor/.env (read by the Python
# service), NOT in the Next.js environment. Listed here for reference only.
# ---------------------------------------------------------------------------
# PROCESSOR_API_KEY=                          # must equal IMAGE_PROCESSING_API_KEY
# PROCESSOR_DEBUG=false                       # true: keep debug files (mask, cut-out, …) per job
# PROCESSOR_SEGMENTATION_MODEL=birefnet-general-lite
# PROCESSOR_MODELS_DIR=./models               # ONNX segmentation models
# PROCESSOR_DATA_DIR=./data                   # job uploads, results, debug files
# PROCESSOR_ASSETS_DIR=../public              # presets/ and brand/ (showroom plate, logo)
# PROCESSOR_CONCURRENCY=1                     # parallel jobs
# PROCESSOR_THREADS=0                         # ONNX Runtime threads (0 = automatic)
# PROCESSOR_JOB_TTL_HOURS=24                  # finished jobs are deleted afterwards
# PROCESSOR_MAX_UPLOAD_MB=40
# SUPABASE_URL=                               # processor only: read originals / write results
# SUPABASE_SERVICE_ROLE_KEY=                  # processor only – NEVER as NEXT_PUBLIC_ variable
