# AutoExperten processor – copy to processor/.env (never commit the real file).
# Real environment variables override values from this file.

# Shared secret: requests must send "Authorization: Bearer <key>".
# Must equal IMAGE_PROCESSING_API_KEY of the Next.js app. Empty = no auth
# (only acceptable on your own machine). Required when SUPABASE_* is set.
# Generate one e.g. with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PROCESSOR_API_KEY=

# true: keep debug images per job (original, mask, cut-out, background,
# composite-before-shadow, shadow, final) under PROCESSOR_DATA_DIR/jobs/<id>/debug.
# NEVER enable on an instance that is reachable from the internet.
PROCESSOR_DEBUG=false

# Segmentation (local ONNX model, CPU). Alternative: isnet-general-use.
# Leave commented for Docker – the image sets the model it was built with and
# disables downloads (the model is baked in).
# PROCESSOR_SEGMENTATION_MODEL=birefnet-general-lite
# PROCESSOR_AUTO_DOWNLOAD_MODELS=true
# PROCESSOR_MODELS_DIR=./models
# PROCESSOR_DATA_DIR=./data
# Folder that contains presets/ and brand/ (default: the Next.js public/ folder)
# PROCESSOR_ASSETS_DIR=../public

# true: also store results composited on the procedural EMERGENCY fallback
# showroom in the app. Default false – app jobs then fail with "Das finale
# AutoExperten-Showroom-Foto fehlt noch" until the master photo exists.
PROCESSOR_ALLOW_FALLBACK_SHOWROOM=false

PROCESSOR_CONCURRENCY=1
PROCESSOR_THREADS=0
PROCESSOR_JOB_TTL_HOURS=24
PROCESSOR_MAX_UPLOAD_MB=40
# Comma separated browser origins (normally empty – the Next.js server calls the processor)
PROCESSOR_CORS_ORIGINS=

# Optional: Supabase access for the JSON job contract used by the app
# (POST /jobs with vehicleId/photoId). Server-side only. Never expose the
# service role key to a browser or a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
