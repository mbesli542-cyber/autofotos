# AutoExperten processor – copy to processor/.env (never commit the real file).
# Real environment variables override values from this file. The same file
# works for `docker run --env-file processor/.env` (values are taken
# literally: no quotes, no comment after a value).

# Shared secret: requests must send "Authorization: Bearer <key>".
# Must equal IMAGE_PROCESSING_API_KEY of the Next.js app. Empty = no auth
# (only acceptable for `uvicorn` on your own machine). Required when SUPABASE_*
# is set, and by the Docker image (see PROCESSOR_REQUIRE_API_KEY).
# Generate one e.g. with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
PROCESSOR_API_KEY=

# true: refuse to start without PROCESSOR_API_KEY. The Docker image sets it to
# true (the deploy compose file forces it); without Docker the default is false.
# Only for a local Docker test without a key: PROCESSOR_REQUIRE_API_KEY=false
# (with the port published on 127.0.0.1 only).
# PROCESSOR_REQUIRE_API_KEY=false

# true: keep debug images per job (original, mask, geometry, grounding, cut-out,
# branded plate, composite-before-shadow, shadow, final, metadata) under
# PROCESSOR_DATA_DIR/jobs/<id>/debug, and serve the API docs /docs and
# /openapi.json (without a key).
# NEVER enable on an instance that is reachable from the internet.
PROCESSOR_DEBUG=false

# Models (local ONNX, CPU): segmentation (alternative: isnet-general-use) and the
# vehicle detector of the semantic mask check. Leave commented for Docker – the
# image sets the models it was built with and disables downloads (baked in).
# PROCESSOR_SEGMENTATION_MODEL=birefnet-general-lite
# PROCESSOR_DETECTOR_MODEL=rf-detr-seg-medium
# PROCESSOR_AUTO_DOWNLOAD_MODELS=true
# PROCESSOR_MODELS_DIR=./models
# PROCESSOR_DATA_DIR=./data
# Folder that contains presets/ and brand/ (default: the Next.js public/ folder)
# PROCESSOR_ASSETS_DIR=../public

# The showroom plates (presets/autoexperten-standard/) are required for exterior
# shots – without them jobs fail with "AutoExperten Showroom-Master fehlt."
# (there is no fallback background).

PROCESSOR_CONCURRENCY=1
PROCESSOR_THREADS=0
PROCESSOR_JOB_TTL_HOURS=24
PROCESSOR_MAX_UPLOAD_MB=40
# Comma separated browser origins (normally empty – the Next.js server calls the processor)
PROCESSOR_CORS_ORIGINS=

# Optional: Supabase access for the JSON job contract used by the app
# (POST /jobs with vehicleId/photoId). Server-side only. Never expose the
# service role key to a browser or a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
